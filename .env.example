# Unique Docker Compose namespace for this deployment directory. Every
# Mainstay instance on a host must use a different project name.
COMPOSE_PROJECT_NAME=mainstay-local

# Mainstay Local control-plane container.
MAINSTAY_LOCAL_IMAGE=mainstay-local:local
# Bind to 0.0.0.0 when the control plane should be reachable from another
# trusted machine on the LAN or VPN. Restrict this port with a firewall when
# the host also has untrusted network interfaces.
MAINSTAY_LOCAL_BIND_ADDRESS=0.0.0.0
MAINSTAY_LOCAL_PORT=8788

# The container reads /app/data/mainstay-local.json when present. If the file is
# absent, it serves the built-in starter registry.
MAINSTAY_LOCAL_CONFIG=/app/data/mainstay-local.json
# Optional parent selected by the first-install wizard. New installations place
# their instance root at MAINSTAY_DATA_PARENT/MAINSTAY_DATA_DIRECTORY_NAME.
MAINSTAY_DATA_PARENT=
# Storage directory name. It defaults to the Compose project name for a fresh
# installation but may remain different after an explicit recovery or rename.
MAINSTAY_DATA_DIRECTORY_NAME=
# Fully resolved instance-specific directory selected by the wizard or by
# `./init-env.sh --data-root PATH`. The helper fills the service-specific bind
# sources beneath this directory. Existing deployments retain this exact path
# without automatic migration. Leave both entries empty for Docker volumes.
MAINSTAY_DATA_ROOT=
MAINSTAY_DATA_RUNTIME_USER=
MAINSTAY_LOCAL_DATA_SOURCE=
MAINSTAY_SAFEBOX_DATA_SOURCE=
MAINSTAY_SPURLINE_DATA_SOURCE=
MAINSTAY_GROVE_DATA_SOURCE=
MAINSTAY_CLEAR_DATA_SOURCE=
# Stable authority for this autonomous Mainstay installation. It commissions
# managed service identities and may itself be authorized by a higher authority.
# The bootstrap helper generates this key; it is never injected into services.
MAINSTAY_INSTALLATION_NSEC=

# Mainstay-managed Safebox Web. init-env.sh generates the cookie key and a
# private onboarding invite code before the first start. Port 8888 is available
# to trusted LAN or VPN clients over HTTP by default. Restrict it with the host
# firewall; use HTTPS instead when crossing an untrusted network.
SAFEBOX_IMAGE=safebox-web:local
SAFEBOX_COOKIE_KEY=
SAFEBOX_ONBOARD_INVITE_CODE=
SAFEBOX_ALLOW_INSECURE_HTTP=true
MAINSTAY_SAFEBOX_BIND_ADDRESS=0.0.0.0
MAINSTAY_SAFEBOX_PORT=8888
# Acorn home mints settle through Lightning and remain external to Mainstay.
MAINSTAY_LIGHTNING_MINT_URL=https://mint.safebox.dev
# Safebox discovers Clear CMUs from both the managed local mint and this
# external mint. CMU balances remain separated by complete keyset ID.
MAINSTAY_EXTERNAL_CLEAR_MINT_URL=https://clear.safebox.dev

# Remote Git build contexts. Replace #main with a tag or commit for a pinned deployment.
MAINSTAY_SAFEBOX_BUILD_CONTEXT=https://github.com/trbouma/safebox-web.git#main
MAINSTAY_SPURLINE_BUILD_CONTEXT=https://github.com/trbouma/spurline.git#main
MAINSTAY_GROVE_BUILD_CONTEXT=https://github.com/trbouma/grove.git#main
MAINSTAY_CLEAR_BUILD_CONTEXT=https://github.com/trbouma/clear.git#main
FORWARDED_ALLOW_IPS=127.0.0.1
SAFEBOX_WEB_WORKERS=1
SAFEBOX_BACKGROUND_JOB_THREADS=2
SAFEBOX_DEFAULT_BOOTSTRAP_RELAY=ws://spurline:8080
SAFEBOX_ALLOWED_WS_RELAYS=ws://spurline:8080
SAFEBOX_SERVICE_ACORN_HOME_RELAY=ws://spurline:8080
# Public NIP-05 discovery hint. This must be an externally reachable wss://
# relay, never the Docker-only ws://spurline:8080 address.
SAFEBOX_NIP05_EXTERNAL_RELAYS=
# The worker creates and retains its private identity in the Safebox data
# volume on first start. Routine restarts recover that same identity.
SAFEBOX_SERVICE_ACORN_MIGRATE=false
SAFEBOX_BLOSSOM_HOME_SERVER=http://grove:8000
SAFEBOX_CLEAR_RECEIVE_ENABLED=true
SAFEBOX_CURRENCY_RATES_ENABLED=false

# Mainstay-managed Spurline relay. The default Compose deployment keeps port
# 8080 private on the project network.
MAINSTAY_SPURLINE_IMAGE=mainstay-local-spurline:local
SPURLINE_VERIFY_SIGNATURES=true
# Stable Nostr identity for this Spurline relay. The bootstrap helper generates
# the private key; Spurline reports and persists only its derived npub.
SPURLINE_SERVICE_NSEC=
SPURLINE_SERVICE_MANAGEMENT=mainstay-managed

# Used only with docker-compose.debug-ports.yaml. Keep the loopback default
# unless another trusted machine needs direct diagnostic access to the relay.
SPURLINE_DEBUG_BIND_ADDRESS=127.0.0.1
SPURLINE_DEBUG_PORT=8780

# Mainstay-managed Grove Blossom server. Its advertised origin remains inside
# the project network until an external gateway is deliberately configured.
MAINSTAY_GROVE_IMAGE=mainstay-local-grove:local
# Stable Nostr identity for this Grove service. The bootstrap helper generates
# the private key; Grove reports and persists only its derived npub.
GROVE_SERVICE_NSEC=
GROVE_SERVICE_MANAGEMENT=mainstay-managed
GROVE_MAX_BLOB_SIZE=104857600
GROVE_AUTH_CLOCK_SKEW_SECONDS=30

# Used only with docker-compose.debug-ports.yaml. This is a diagnostic route;
# Grove continues to identify itself to bundle clients as http://grove:8000.
GROVE_DEBUG_BIND_ADDRESS=127.0.0.1
GROVE_DEBUG_PORT=8001

# Mainstay-managed Clear mint. Generate these independently with
# `openssl rand -hex 32` before the first start. Preserve CLEAR_MASTER_SECRET
# with the mint database: changing it changes the mint's root keyset identity.
CLEAR_MASTER_SECRET=
CLEAR_OPERATOR_TOKEN=
# Stable Nostr communication identity for the managed Clear service. The
# bootstrap helper generates a 32-byte private key; Clear reports only its npub.
CLEAR_MINT_SERVICE_NSEC=
CLEAR_MINT_SERVICE_MANAGEMENT=mainstay-managed
MAINSTAY_CLEAR_IMAGE=mainstay-local-clear:local
CLEAR_MINT_URL=http://clear:3339
CLEAR_CURRENCY_NAME=Mainstay Local Credits
CLEAR_CURRENCY_ALIAS=Local Credits
CLEAR_CURRENCY_UNIT_ALIAS=credits
CLEAR_MAX_ORDER=20
CLEAR_ROOT_AUTHORITY_NPUB=
CLEAR_LOG_LEVEL=info

# Used only with docker-compose.debug-ports.yaml. This does not change the
# canonical URL encoded into Mint Notes.
CLEAR_DEBUG_BIND_ADDRESS=127.0.0.1
CLEAR_DEBUG_PORT=3340
