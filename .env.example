# Mainstay Local control-plane container.
MAINSTAY_LOCAL_IMAGE=mainstay-local:local
# Bind to 0.0.0.0 when the control plane should be reachable from another
# trusted machine on the LAN or VPN. Restrict this port with a firewall when
# the host also has untrusted network interfaces.
MAINSTAY_LOCAL_BIND_ADDRESS=0.0.0.0
MAINSTAY_LOCAL_PORT=8788

# The container reads /app/data/mainstay-local.json when present. If the file is
# absent, it serves the built-in starter registry.
MAINSTAY_LOCAL_CONFIG=/app/data/mainstay-local.json

# Mainstay-managed Safebox Web. init-env.sh generates the cookie key and a
# private onboarding invite code before the first start. Port 8888 is available
# to trusted LAN or VPN clients over HTTP by default. Restrict it with the host
# firewall; use HTTPS instead when crossing an untrusted network.
SAFEBOX_IMAGE=safebox-web:local
SAFEBOX_COOKIE_KEY=
SAFEBOX_ONBOARD_INVITE_CODE=
SAFEBOX_ALLOW_INSECURE_HTTP=true
SAFEBOX_ALLOW_INSECURE_MINTS=true
MAINSTAY_SAFEBOX_BIND_ADDRESS=0.0.0.0
MAINSTAY_SAFEBOX_PORT=8888
FORWARDED_ALLOW_IPS=127.0.0.1
SAFEBOX_WEB_WORKERS=1
SAFEBOX_BACKGROUND_JOB_THREADS=2
SAFEBOX_DEFAULT_BOOTSTRAP_RELAY=ws://spurline:8080
SAFEBOX_ALLOWED_WS_RELAYS=ws://spurline:8080
SAFEBOX_SERVICE_ACORN_HOME_RELAY=ws://spurline:8080
SAFEBOX_DEFAULT_HOME_MINT=http://clear:3339
SAFEBOX_SERVICE_ACORN_HOME_MINT=http://clear:3339
SAFEBOX_BLOSSOM_HOME_SERVER=http://grove:8000
SAFEBOX_CLEAR_RECEIVE_ENABLED=true
SAFEBOX_CLEAR_MINTS=http://clear:3339
SAFEBOX_CURRENCY_RATES_ENABLED=false

# Mainstay-managed Spurline relay. The default Compose deployment keeps port
# 8080 private on the project network.
MAINSTAY_SPURLINE_IMAGE=mainstay-local-spurline:local
SPURLINE_VERIFY_SIGNATURES=true

# Used only with docker-compose.debug-ports.yaml. Keep the loopback default
# unless another trusted machine needs direct diagnostic access to the relay.
SPURLINE_DEBUG_BIND_ADDRESS=127.0.0.1
SPURLINE_DEBUG_PORT=8780

# Mainstay-managed Grove Blossom server. Its advertised origin remains inside
# the project network until an external gateway is deliberately configured.
MAINSTAY_GROVE_IMAGE=mainstay-local-grove:local
GROVE_MAX_BLOB_SIZE=104857600
GROVE_AUTH_CLOCK_SKEW_SECONDS=30

# Used only with docker-compose.debug-ports.yaml. This is a diagnostic route;
# Grove continues to identify itself to bundle clients as http://grove:8000.
GROVE_DEBUG_BIND_ADDRESS=127.0.0.1
GROVE_DEBUG_PORT=8001

# Mainstay-managed Clear mint. Generate these independently with
# `openssl rand -hex 32` before the first start. Preserve CLEAR_MASTER_SECRET
# with the mint database: changing it changes the mint's root keyset identity.
CLEAR_MASTER_SECRET=
CLEAR_OPERATOR_TOKEN=
MAINSTAY_CLEAR_IMAGE=mainstay-local-clear:local
CLEAR_MINT_URL=http://clear:3339
CLEAR_CURRENCY_NAME=Mainstay Local Credits
CLEAR_CURRENCY_ALIAS=Local Credits
CLEAR_CURRENCY_UNIT_ALIAS=credits
CLEAR_MAX_ORDER=20
CLEAR_ROOT_AUTHORITY_NPUB=
CLEAR_LOG_LEVEL=info

# Used only with docker-compose.debug-ports.yaml. This does not change the
# canonical URL encoded into Mint Notes.
CLEAR_DEBUG_BIND_ADDRESS=127.0.0.1
CLEAR_DEBUG_PORT=3340
