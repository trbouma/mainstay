# Mainstay Local control-plane container.
MAINSTAY_LOCAL_IMAGE=mainstay-local:local
# Bind to 0.0.0.0 when the control plane should be reachable from another
# trusted machine on the LAN or VPN. Restrict this port with a firewall when
# the host also has untrusted network interfaces.
MAINSTAY_LOCAL_BIND_ADDRESS=0.0.0.0
MAINSTAY_LOCAL_PORT=8788

# The container reads /app/data/mainstay-local.json when present. If the file is
# absent, it serves the built-in starter registry.
MAINSTAY_LOCAL_CONFIG=/app/data/mainstay-local.json
